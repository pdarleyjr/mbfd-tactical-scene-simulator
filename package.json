{
  "name": "mbfd-tactical-scene-simulator",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mbfd/web --filter @mbfd/sync dev",
    "dev:e2e": "pnpm --parallel --filter @mbfd/web --filter @mbfd/sync dev:e2e",
    "build": "pnpm --filter @mbfd/web --filter @mbfd/sync build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint apps packages",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
