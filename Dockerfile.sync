FROM node:24.18.0-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/sync ./apps/sync
RUN pnpm install --frozen-lockfile --filter @mbfd/sync...
RUN pnpm --filter @mbfd/sync build

# One self-contained bundle: no node_modules in the runtime image.
FROM node:24.18.0-bookworm-slim
ENV NODE_ENV=production PORT=8090 DATA_DIR=/data
WORKDIR /app
RUN mkdir -p /data && chown node:node /data
COPY --from=build /workspace/apps/sync/dist/server.mjs ./server.mjs
USER node
EXPOSE 8090
CMD ["node", "server.mjs"]
