{
  "name": "@mbfd/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:e2e": "tsx src/dev-memory.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@hocuspocus/extension-database": "^4.5.0",
    "@hocuspocus/server": "^4.5.0",
    "@mbfd/collaboration": "workspace:*",
    "@mbfd/domain": "workspace:*",
    "@mbfd/fire-model": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  }
}
